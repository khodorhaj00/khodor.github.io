# Copy to .env (docker compose reads it automatically). Every value below is the default.

# Port the appserver listens on.
PORT=8080

# If set, every request except GET /health must send this value in the X-Api-Key header.
APP_API_KEY=

# Rhino.Compute base URL (the rhino.compute front end, port 5000 by default). Windows-only,
# see README. Leave EMPTY to run without Compute: /convert then skips unmeshed Breps and
# /mesh answers 502 compute_unreachable when a file needs tessellation.
COMPUTE_URL=http://localhost:5000/

# Sent to Compute as the RhinoComputeKey header (the key you configured on the Compute host).
COMPUTE_API_KEY=

# Per Compute call: timeout and number of Breps per call.
COMPUTE_TIMEOUT_MS=120000
COMPUTE_BATCH=20

# Request body limit in MB (413 too_large above it).
MAX_UPLOAD_MB=200

# Meshing quality when the request has no ?quality= parameter: draft | default | fine.
MESH_QUALITY=default

# error | warn | info | debug
LOG_LEVEL=info
